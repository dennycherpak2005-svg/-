          "response": { "response": { "responseFormat": "text" } },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-368, 144],
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Website scrapen",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// E-Mail von der Website holen, falls das CRM keine geliefert hat.\nconst lead = $('Lead normalisieren').item.json;\nlet email = (lead.Email || '').trim();\n\nlet html = '';\ntry { html = $input.first().json.data || $input.first().json.body || ''; } catch (e) {}\n\nif (!email && html) {\n  const matches = String(html).match(/[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}/g) || [];\n  const junk = /(\\.png|\\.jpg|\\.jpeg|\\.gif|\\.webp|\\.svg|sentry|wixpress|example|@2x|domain\\.com)/i;\n  const good = matches.find((m) => !junk.test(m));\n  if (good) email = good;\n}\n\nreturn [{ json: { ...lead, Email: email } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-144, 144],
