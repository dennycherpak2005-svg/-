      "parameters": {
        "jsCode": "// Daten vom CRM annehmen (JSON oder Text-Fallback) und mappen.\nconst raw = $json.body ?? $json;\nlet d = raw;\nif (typeof raw === 'string') {\n  try { d = JSON.parse(raw); } catch (e) { d = {}; }\n}\n\nreturn [{\n  json: {\n    Firma: (d.company || d.Firma || d.name || '').trim(),\n    Ansprechpartner: (d.name || d.Ansprechpartner || '').trim(),\n    Email: (d.email || d.Email || '').trim(),\n    Website: (d.website || d.Website || '').trim(),\n    Branche: (d.source || d.Branche || '').trim(),\n    Ort: (d.location || d.Ort || '').trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-816, 240],
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Lead normalisieren"
    },
