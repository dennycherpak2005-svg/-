              "maxRedirects": 3
            }
          },
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        140
      ],
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Homepage scrapen",
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{ $('Impressum-URL bauen').item.json.impressumUrl }}",
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 3
            }
          },
          "response": {
            "response": {
              "responseFormat": "text"
            }
