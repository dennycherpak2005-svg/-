      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        140
      ],
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Impressum scrapen",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Lead normalisieren').item.json;\nlet homeHtml = '', impHtml = '';\ntry { const h = $('Homepage scrapen').item.json; homeHtml = h.data || h.body || ''; } catch (e) {}\ntry { const i = $('Impressum scrapen').item.json; impHtml = i.data || i.body || ''; } catch (e) {}\nconst strip = (h) => String(h || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\\s+/g, ' ');\nconst homeText = strip(homeHtml), impText = strip(impHtml);\n\nlet email = (lead.Email || '').trim();\nif (!email) {\n  const junk = /(\\.png|\\.jpg|\\.jpeg|\\.gif|\\.webp|\\.svg|sentry|wixpress|example|@2x|domain\\.com)/i;\n  const grab = (t) => (String(t).match(/[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}/g) || []).find((m) => !junk.test(m));\n  email = grab(impHtml) || grab(homeHtml) || '';\n}\n\nfunction findGF(t) {\n  if (!t) return '';\n  const pats = [\n    /Gesch[aä]ftsf[uü]hrer(?:in)?(?:\\s*\\([^)]*\\))?\\s*:?\\s*([A-ZÄÖÜ][a-zäöüß]+(?:\\s+[A-ZÄÖÜ][a-zäöüß]+){1,2})/,\n    /Vertreten durch\\s*:?\\s*(?:den |die )?(?:Gesch[aä]ftsf[uü]hrer(?:in)?\\s*)?([A-ZÄÖÜ][a-zäöüß]+\\s+[A-ZÄÖÜ][a-zäöüß]+)/,\n    /Inhaber(?:in)?\\s*:?\\s*([A-ZÄÖÜ][a-zäöüß]+\\s+[A-ZÄÖÜ][a-zäöüß]+)/\n  ];\n  for (const re of pats) { const m = t.match(re); if (m) return m[1].trim(); }\n  return '';\n}\nconst gf = findGF(impText) || findGF(homeText);\n\nconst MALE = new Set(['alexander','andreas','thomas','michael','stefan','stephan','christian','daniel','markus','marcus','martin','peter','jan','jens','frank','klaus','wolfgang','jürgen','juergen','dirk','sven','tobias','sebastian','florian','felix','lukas','lucas','max','maximilian','paul','jonas','david','philipp','simon','benjamin','tim','niklas','dennis','denis','marco','marko','oliver','holger','ralf','ralph','uwe','dieter','bernd','heinz','manfred','rainer','reiner','torsten','thorsten','matthias','mathias','kai','lars','nico','patrick','robert','denny','erik','hans','georg','werner','günter','guenter','norbert']);\nconst FEMALE = new Set(['anna','anne','maria','marie','sabine','susanne','andrea','petra','claudia','julia','katrin','kathrin','katharina','christina','christine','nicole','stefanie','stephanie','sandra','melanie','laura','lisa','sarah','sara','lena','lea','hannah','hanna','emma','birgit','gabriele','gabi','monika','brigitte','renate','ursula','ingrid','karin','heike','silke','tanja','jessica','vanessa','michaela','manuela','daniela','franziska','johanna','sophie','sophia','annika','jana','janina','nadine','elke','helga','gisela','erika']);\n\nfunction anredeFor(name) {\n  if (!name || name === lead.Firma) return 'Guten Tag';\n  const parts = name.trim().split(/\\s+/);\n  const first = parts[0].toLowerCase();\n  const last = parts[parts.length - 1];\n  if (MALE.has(first)) return 'Hallo Herr ' + last;\n  if (FEMALE.has(first)) return 'Hallo Frau ' + last;\n  return 'Hallo ' + name;\n}\nconst ansprech = gf || (lead.Ansprechpartner && lead.Ansprechpartner !== lead.Firma ? lead.Ansprechpartner : '');\nreturn [{ json: { Firma: lead.Firma, Ansprechpartner: ansprech, Email: email, Website: lead.Website, Branche: lead.Branche, Ort: lead.Ort, Anrede: anredeFor(ansprech) } }];"
      },
