    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "=Frage zu {{ $json.Firma }}",
        "emailType": "text",
        "message": "={{ $json.Anrede }},\\n\\nkurze Frage: Was passiert bei {{ $json.Firma }}, wenn abends oder am Wochenende eine Kundenanfrage reinkommt?\\n\\nBei vielen Betrieben bleibt sie bis zum nächsten Werktag liegen – und der Interessent ist bis dahin oft schon woanders.\\n\\nIch richte Betrieben einen kleinen Assistenten für die Website ein, der genau solche Anfragen rund um die Uhr beantwortet und die Kontaktdaten festhält. Fertig eingerichtet, kein Aufwand für Sie.\\n\\nWäre das für {{ $json.Firma }} einen kurzen Blick wert? Dann schicke ich Ihnen ein 2-Minuten-Beispiel – ganz unverbindlich.\\n\\nViele Grüße\\nDenny Cherpak\\nDC Marketing & Automation",
        "options": {
          "appendAttribution": false,
          "senderName": "Denny Cherpak"
        }
      },
