    },
    {
      "parameters": {
        "jsCode": "// Daten vom CRM annehmen (JSON oder Text-Fallback) und mappen.\nconst raw = $json.body ?? $json;\nlet d = raw;\nif (typeof raw === 'string') { try { d = JSON.parse(raw); } catch (e) { d = {}; } }\nreturn [{ json: {\n  Firma: (d.company || d.Firma || d.name || '').trim(),\n  Ansprechpartner: (d.name || d.Ansprechpartner || '').trim(),\n  Email: (d.email || d.Email || '').trim(),\n  Website: (d.website || d.Website || '').trim(),\n  Branche: (d.source || d.Branche || '').trim(),\n  Ort: (d.location || d.Ort || '').trim()\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1060,
        240
      ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Lead normalisieren"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-website",
              "leftValue": "={{ $json.Website }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -840,
        240
      ],
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Website vorhanden?"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Lead normalisieren').item.json;\nlet w = (lead.Website || '').trim();\nif (w && !w.startsWith('http')) w = 'https://' + w;\nlet homeUrl = w, impressumUrl = w;\ntry { const u = new URL(w); homeUrl = u.origin; impressumUrl = u.origin + '/impressum'; } catch (e) {}\nreturn [{ json: { ...lead, homeUrl, impressumUrl } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        140
      ],
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Impressum-URL bauen"
    },
    {
      "parameters": {
        "url": "={{ $json.homeUrl }}",
        "options": {
          "redirect": {
