# Passwort-Schutz: NUR du kommst mit diesem Passwort rein.
# Wenn leer/nicht gesetzt, ist die App offen (nur für lokale Entwicklung sinnvoll).
APP_PASSWORD=

# Google Maps Scraper (Google Places API "Text Search").
# Ohne Key läuft das Dashboard im Demo-Modus mit Beispiel-Leads.
# Key holen: https://console.cloud.google.com → Places API (New) aktivieren → API-Key erstellen
GOOGLE_MAPS_API_KEY=

# Optional: eigener Speicherort für den JSON-Datastore (sonst ./data bzw. /tmp auf Vercel)
# DATA_DIR=

# Optional: Token zum Absichern des /api/ingest Webhooks (falls du ihn doch nutzt)
# INGEST_TOKEN=
